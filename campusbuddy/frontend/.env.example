# ---- CampusBuddy env (frontend + /api/v1 route handlers) ----

# Postgres — the app is fully DB-backed
DATABASE_URL=postgresql://campusbuddy:campusbuddy@localhost:5433/campusbuddy?schema=public

# Signs the session cookie (JWT) and salts login-code hashes. Use a long random
# string in production: `openssl rand -base64 48`
AUTH_SECRET=change-me

# Email delivery for 6-digit sign-in codes (https://resend.com). Setting this
# enables real emailed OTP AND switches off dev-auth (see below). In production
# this is how students actually receive their code — leave it set.
RESEND_API_KEY=
EMAIL_FROM=CampusBuddy <hello@campusbuddy.sg>

# Dev-auth escape hatch. Dev-auth surfaces the login code on-screen and enables
# the one-tap account switcher — CONVENIENT but INSECURE (anyone can read a code
# for any campus email and sign in as that user). It is HARD-OFF in production by
# default; it only runs off-prod (local dev) or when you set ALLOW_DEV_AUTH=1
# here. NEVER set this on a public production deployment — it is an account-
# takeover switch, only for a private demo you control.
ALLOW_DEV_AUTH=

# Web Push (VAPID). Generate your own pair — never reuse an example key:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Push is best-effort and simply no-ops if these are unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:hello@campusbuddy.sg
