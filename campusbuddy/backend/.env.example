# ---- CampusBuddy backend env ----
NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://campusbuddy:campusbuddy@localhost:5432/campusbuddy?schema=public

# Redis (BullMQ, cache, rate limiting)
REDIS_URL=redis://localhost:6379

# NTU email allowlist (comma-separated domain suffixes)
NTU_EMAIL_DOMAINS=e.ntu.edu.sg,ntu.edu.sg,staff.main.ntu.edu.sg

# Auth (shared secret with the Next.js Auth.js app for session verification)
AUTH_SHARED_SECRET=change-me

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLATFORM_FEE_BPS=1500          # 15.00%
MIN_PLATFORM_FEE_CENTS=100     # S$1.00 fee floor (see docs/13)
MIN_TASK_CENTS=500             # S$5.00 minimum task value

# AWS S3 (private bucket for ID/photos; presigned uploads)
AWS_REGION=ap-southeast-1
S3_BUCKET=campusbuddy-private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (Resend/Postmark)
EMAIL_API_KEY=
EMAIL_FROM=hello@campusbuddy.sg

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@campusbuddy.sg

# CORS
FRONTEND_ORIGIN=http://localhost:3000
